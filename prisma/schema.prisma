generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Application {
  id              String   @id @default(cuid())

  fullName        String
  tcKimlik        String   @unique
  phone           String
  email           String
  birthDate       DateTime

  job             String
  company         String?
  employment      String
  workYears       Int
  monthlyIncome   Float

  creditType      String
  creditAmount    Float
  installment     Int

  kvkkAccepted    Boolean
  consentAccepted Boolean

  status          String   @default("Bekliyor")
  riskScore       Int?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Admin {
  id        String   @id @default(cuid())

  name      String
  email     String   @unique
  password  String

  role      Role     @default(EDITOR)

  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  EDITOR
}